# Copia este archivo a `.env` y ajusta los valores. `.env` nunca se sube al repo.

# Cadena de conexión de PostgreSQL. La base tiene que tener PostGIS:
#   CREATE EXTENSION IF NOT EXISTS postgis;
# La primera migración lo hace sola, pero el rol necesita permiso para crearla.
DATABASE_URL="postgresql://macbook@localhost:5432/petgo_grado?schema=public"

# Secreto de firma de los JWT. En producción, algo aleatorio y largo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-algo-aleatorio-y-largo-en-produccion"

# Cuánto dura una sesión.
JWT_EXPIRA="30d"

PORT=4000

# Orígenes permitidos por CORS, separados por coma.
# Expo Go no manda cabecera Origin, así que en desarrollo esto casi no aplica;
# importa cuando la app corra en web o detrás de un dominio.
CORS_ORIGENES="http://localhost:8081,http://localhost:19006"
